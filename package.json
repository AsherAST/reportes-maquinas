{
  "name": "reportes-maquinas-mvp",
  "version": "1.0.0",
  "description": "App reportes de máquinas por voz: móvil -> PC apareado",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "cap:init": "cap init",
    "cap:sync": "cap sync",
    "cap:open": "cap open android"
  },
  "build": {
    "appId": "com.reportes.maquinas.pc",
    "productName": "Reportes Maquinas PC",
    "files": [
      "server.js",
      "public/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.bin/**/*",
      "!node_modules/@capacitor/cli/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/cli": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
